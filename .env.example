# A verified inbox that should receive quote requests
QUOTE_TO_EMAIL=
# A sender address on a domain verified with Resend
QUOTE_FROM_EMAIL=
RESEND_API_KEY=
# Durable request limits for a serverless deployment
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SECRET=
# Local development only: accepts test requests without sending email
QUOTE_TEST_MODE=0
# Set to 1 only after launch review; previews remain noindex
PUBLIC_SITE_INDEXABLE=0
